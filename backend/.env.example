# Database - PostgreSQL (Production) or SQLite (Local Dev)
# For Railway: Get this from Railway PostgreSQL database Variables
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# For local development with SQLite (uncomment this):
# DATABASE_URL="file:./prisma/les_private.db"

# Server
PORT=5000
NODE_ENV=production

# CORS - Add your Vercel domain here
CORS_ORIGIN=https://your-app.vercel.app

# App
TEACHER_NAME="Bu Rafika"
