// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id                    Int       @id @default(autoincrement())
  name                  String
  grade                 String
  parentName            String    @map("parent_name")
  parentWhatsapp        String?   @map("parent_whatsapp")
  address               String?
  tarif                 Int?      // Tarif per pertemuan dalam Rupiah
  status                String    @default("active") // active | inactive
  meetingCount          Int       @default(0) @map("meeting_count") // Counter pertemuan hadir
  
  // Salary Configuration per Student
  salaryScheduleType    String    @default("per_10_meetings") @map("salary_schedule_type") // per_10_meetings | monthly
  monthlyPaymentDate    Int?      @map("monthly_payment_date") // 1-28 untuk tanggal pembayaran bulanan
  
  lastReportSentAt      DateTime? @map("last_report_sent_at") // Kapan terakhir kirim laporan
  lastMonthlySentAt     DateTime? @map("last_monthly_sent_at") // Kapan terakhir kirim laporan bulanan
  lastSalaryGeneratedAt DateTime? @map("last_salary_generated_at") // Kapan terakhir generate gaji
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  dailyReports          DailyReport[]
  schedules             Schedule[]
  salaryRecords         SalaryRecord[]

  @@index([status])
  @@index([name])
  @@index([meetingCount])
  @@index([salaryScheduleType])
  @@map("students")
}

model Schedule {
  id          Int      @id @default(autoincrement())
  studentId   Int      @map("student_id")
  dayOfWeek   String   @map("day_of_week") // Senin, Selasa, dst
  startTime   String   @map("start_time") // HH:MM format
  endTime     String   @map("end_time")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([dayOfWeek])
  @@map("schedules")
}

model DailyReport {
  id                  Int      @id @default(autoincrement())
  studentId           Int      @map("student_id")
  date                DateTime
  startTime           String   @map("start_time") // HH:MM format
  endTime             String   @map("end_time")
  subject             String   // Matematika, IPA, Bahasa Indonesia
  topic               String
  enthusiasmScore     Int      @map("enthusiasm_score") // 1-5
  focusScore          Int      @map("focus_score") // 1-5
  understandingScore  Int      @map("understanding_score") // 1-5
  homework            String?
  progressNotes       String?  @map("progress_notes")
  parentNotes         String?  @map("parent_notes")
  attendanceStatus    String   @default("present") @map("attendance_status") // present | excused | sick | cancelled
  paymentStatus       String   @default("unpaid") @map("payment_status") // paid | unpaid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([date])
  @@index([studentId, date])
  @@index([paymentStatus])
  @@map("daily_reports")
}

model SalaryRecord {
  id                Int      @id @default(autoincrement())
  studentId         Int      @map("student_id")
  periodType        String   @map("period_type") // per_10_meetings | monthly
  periodStart       DateTime @map("period_start")
  periodEnd         DateTime @map("period_end")
  meetingCount      Int      @map("meeting_count") // Jumlah pertemuan dalam periode ini
  totalAmount       Int      @map("total_amount") // Total gaji dari tarif x meetingCount
  isPaid            Boolean  @default(false) @map("is_paid")
  paidAt            DateTime? @map("paid_at")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([periodType])
  @@index([isPaid])
  @@index([periodStart, periodEnd])
  @@map("salary_records")
}
